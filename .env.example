RADAR_BIND=127.0.0.1
RADAR_PORT=3000
RADAR_DATA_VOLUME=radar_data
SIGNUP_CODE=
COOKIE_SECURE=0
# 可选：64 位十六进制密钥；留空自动保存到数据目录 credentials.key，备份须包含该文件
CREDENTIALS_KEY=
# 仅在可信 HTTPS 反向代理后启用
TRUST_PROXY=0
FLARESOLVERR_ENABLED=0
FLARESOLVERR_URL=http://flaresolverr:8191/v1
FLARESOLVERR_TIMEOUT_MS=60000
# 会话有效期（分钟）
FLARESOLVERR_SESSION_TTL=15
RESEND_API_KEY=
MAIL_FROM=
# 下单浏览器容量：总量、后台、会话校验；正整数，非法值使用默认值
BROWSER_MAX_SLOTS=4
BROWSER_BACKGROUND_MAX=2
BROWSER_VERIFY_MAX=1
# 下单等待预算（毫秒）
ORDER_AI_TIMEOUT_MS=120000
ORDER_AGENT_TIMEOUT_MS=600000
ORDER_TRIAL_TIMEOUT_MS=1500000
ORDER_RESTOCK_AI_TIMEOUT_MS=180000
ORDER_RESTOCK_AGENT_TIMEOUT_MS=1800000
